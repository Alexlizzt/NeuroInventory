# =============================================================================
# Variables del Jenkins de CI (docker-compose.jenkins.yml)
#
#   cp .env.jenkins.example .env.jenkins
#   docker compose -f docker-compose.jenkins.yml --env-file .env.jenkins up -d --build
#
# .env.jenkins está ignorado por git: contiene credenciales.
# =============================================================================

# --- Interfaz web -----------------------------------------------------------
JENKINS_PORT=8085
JENKINS_AGENT_PORT=50000

# --- Administrador local ----------------------------------------------------
# Cambia la contraseña antes del primer arranque. JCasC la vuelve a aplicar al
# recrear el contenedor.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin

# --- Repositorio y rama del job --------------------------------------------
GIT_REPO_URL=https://github.com/Alexlizzt/NeuroInventory.git
GIT_BRANCH=main

# --- Docker Hub (credencial `dockerhub`) ------------------------------------
# Usa un token de acceso, no tu contraseña. Solo se usa si lanzas el build con
# el parámetro PUSH_IMAGES activado.
DOCKERHUB_USERNAME=neuroinventory
DOCKERHUB_TOKEN=changeme
